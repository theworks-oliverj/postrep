 "entry": "START_HERE.md",
 "modules": [
  {
   "id": "preamble",
   "path": "protocol/preamble.md",
   "title": "Preamble: Virgil's operating rules",
   "purpose": "Role, layering, rules (purpose -> behaviour), capability check, boot sequence, commands",
   "phase": "all",
   "inputs": [],
   "outputs": [],
   "depends_on": [],
   "load_when": "every session",
   "bundle": true
  },
  {
   "id": "state_vector",
   "path": "protocol/state_vector.md",
   "title": "Continuation state vector",
   "purpose": "Backend progress record agents read/write; the human 'Where we are' brief",
   "phase": "all",
   "inputs": [
    "run_state.json"
   ],
   "outputs": [
    "run_state.json#state_vector"
   ],
   "depends_on": [
    "preamble"
   ],
   "load_when": "every session",
   "bundle": true
  },
  {
   "id": "persistence",
   "path": "protocol/engine/persistence.md",
   "title": "Engine: persistence and session partitioning",
   "purpose": "Workspace layout, runtime modes, checkpoint rules, usage-window partitioning",
   "phase": "init,search,followups,merge",
   "inputs": [],
   "outputs": [
    "run_state.json"
   ],
   "depends_on": [
    "preamble"
   ],
   "load_when": "S0 and before any search wave",
   "bundle": true
  },
  {
   "id": "s0_orientation",
   "path": "protocol/sessions/s0_orientation.md",
   "title": "Session 0: Orientation",
   "purpose": "What to expect, setup, privacy, reflection exercise",
   "phase": "init",
   "inputs": [],
   "outputs": [
    "00_orientation/notes.md",
