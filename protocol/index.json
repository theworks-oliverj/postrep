   "load_when": "phases merge and verify",
   "bundle": true
  },
  {
   "id": "s9_deliverables",
   "path": "protocol/sessions/s9_deliverables.md",
   "title": "Session 9: Deliverables",
   "purpose": "Options Rundown and Due-Diligence One-Pager",
   "phase": "deliverables",
   "inputs": [
    "05_merge/merged.json",
    "06_verify/verification.json"
