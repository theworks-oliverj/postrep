   "phase": "all",
   "inputs": [],
   "outputs": [],
   "depends_on": [
    "data_contract"
   ],
   "load_when": "writing JSON without scripts",
   "bundle": true
  },
  {
   "id": "scripts",
   "path": "protocol/engine/scripts.md",
   "title": "Engine: scripts reference",
   "purpose": "CLI for every script",
   "phase": "all",
   "inputs": [],
   "outputs": [],
