   "outputs": [
    "07_deliverables/options_rundown.md",
    "07_deliverables/due_diligence.md"
   ],
   "depends_on": [
    "s8_merge_verify"
   ],
   "load_when": "phase deliverables",
   "bundle": true
  },
  {
   "id": "quality_bar",
   "path": "protocol/engine/quality_bar.md",
