    "s0_orientation"
   ],
   "load_when": "phase life_plan",
   "bundle": true
  },
  {
   "id": "s2_pathway_map",
   "path": "protocol/sessions/s2_pathway_map.md",
   "title": "Session 2: Study & Pathway Map",
   "purpose": "Knowledge domains, pathway signals, benchmarks, anchors; rubric PM-1.0",
   "phase": "map",
   "inputs": [
    "01_life_plan/life_plan.json"
   ],
   "outputs": [
    "02_map/study_pathway_map.json",
    "02_map/benchmarks.json",
